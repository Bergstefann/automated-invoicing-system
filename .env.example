# Copy to .env and fill in for real (non-demo) use.
# --demo mode requires none of this — it runs entirely on fake providers and synthetic data.

# SQLite database path
INVOICING_DB_PATH=invoicing.db

# Term start date (ISO 8601). Fortnightly billing periods are derived from this.
INVOICING_TERM_START=2026-02-02

# Google Sheets — the spreadsheet ID from its URL, and the tab holding the
# Lesson Schedule grid (row 1 = dates, one row per student below that).
INVOICING_SHEET_ID=
INVOICING_SCHEDULE_TAB=Lesson Schedule

# Google OAuth — a single credential covers Sheets, Docs, Drive, and Gmail
# (see providers/google.py's OAUTH_SCOPES). credentials.json is the client
# secret downloaded from Google Cloud Console; token.json is written on
# first run after you complete the browser consent flow, and reused after
# that until it expires.
INVOICING_OAUTH_CLIENT_SECRET_FILE=credentials/credentials.json
INVOICING_OAUTH_TOKEN_FILE=credentials/token.json

# Invoice output
INVOICING_DRIVE_OUTPUT_FOLDER_ID=
INVOICING_DOC_TEMPLATE_SHORT_ID=
INVOICING_DOC_TEMPLATE_LONG_ID=

# Sender identity (used in email + invoice doc)
INVOICING_SENDER_NAME=Jane Tutor
INVOICING_SENDER_EMAIL=jane@example.com
